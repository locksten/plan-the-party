{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm test && pnpm build",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
